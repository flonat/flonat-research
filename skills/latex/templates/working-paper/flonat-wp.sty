\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{flonat-wp}[2026/02/18 Working paper style — packages, layout, math]

% ============================================
% Core Packages
% ============================================
% Requires LuaLaTeX (fontspec + unicode-math need a Unicode engine)
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\RequirePackage{mathtools,amssymb,amsmath,amsfonts,amsthm}
\RequirePackage{array}
\RequirePackage{bbm}
\RequirePackage{booktabs}
\RequirePackage{caption}
\RequirePackage{comment}
\RequirePackage{csquotes}
\RequirePackage{dcolumn}
\RequirePackage{enumitem}
\RequirePackage{etoolbox}
\RequirePackage{eurosym}
\RequirePackage{fancyhdr}
\RequirePackage{float}
\RequirePackage{fontspec}
\RequirePackage{footmisc}
\RequirePackage[left = 1.0in,
            right = 1.0in,
            top = 1.0in,
            bottom = 1.0in
            ]{geometry}
\RequirePackage{graphicx}
\RequirePackage{longtable}
\RequirePackage{microtype}
\RequirePackage{multirow}
\RequirePackage{pdflscape}
\RequirePackage{pdfpages}
\RequirePackage{setspace}
\RequirePackage{siunitx}
\RequirePackage{soul}
\RequirePackage{subcaption}
\RequirePackage{tabularx}
% thmtools removed 2026-06-27: unused (theorems use amsthm \newtheorem below),
% and under lualatex its patched \newtheorem double-defines theorem counters
% (\c@proposition "already defined"), aggravated by old cleveref's kernel
% first-aid. Re-add only alongside \declaretheorem usage, after verifying the
% counter clash is resolved. See flonat/latex-wp commit.
\RequirePackage{threeparttable}
\RequirePackage{tikz}
\RequirePackage{titlesec}
\RequirePackage{unicode-math}
\RequirePackage[dvipsnames]{xcolor}

\RequirePackage{threeparttablex}
\let\threeparttable\ThreePartTable
\let\endthreeparttable\endThreePartTable

% ============================================
% Hyperref Configuration
% ============================================
\RequirePackage{hyperref}
\hypersetup{
    citecolor=NavyBlue,
    colorlinks=true,
    linkcolor=black,
    filecolor=NavyBlue,
    urlcolor=NavyBlue,
    anchorcolor=NavyBlue,
    breaklinks=true
}
\urlstyle{same}

\RequirePackage{cleveref}

% ============================================
% Spacing
% ============================================
\onehalfspacing

% ============================================
% Custom Commands
% ============================================
\newcommand{\red}[1]{{\color{red} #1}}
\newcommand{\blue}[1]{{\color{blue} #1}}
\newcommand{\todo}[1]{{\color{red}\textbf{TODO:} #1}}

\newcolumntype{L}[1]{>{\raggedright\let\newline\\arraybackslash\hspace{0pt}}m{#1}}
\newcolumntype{C}[1]{>{\centering\let\newline\\arraybackslash\hspace{0pt}}m{#1}}
\newcolumntype{R}[1]{>{\raggedleft\let\newline\\arraybackslash\hspace{0pt}}m{#1}}

% ============================================
% Math and Proofs
% ============================================

% Shared math core (macros, operators, theorem environments) lives in
% flonat-math.sty so venue papers get the identical set — see that file.
% [eqnsection] keeps the working-paper (1.1), (1.2) per-section numbering.
\RequirePackage[eqnsection]{flonat-math}
